# Local-only application settings. Copy to .env to override defaults.
API_HOST=127.0.0.1
API_PORT=8000
VITE_PORT=5173
VITE_API_URL=http://127.0.0.1:8000
SQLITE_PATH=data/cyberguard.sqlite3

# Optional cloud advisory. Keep disabled unless you explicitly choose to transmit email text.
ENABLE_CLOUD_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
